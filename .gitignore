# ============================================================
# 构建产物 / 本地运行环境（不上传）
# ============================================================
build/
.gradle/
.gradle_home/
run/
out/
bin/
# datagen 自动生成产物（构建时重新生成，非手写源码）
src/generated/

# ============================================================
# 调试 / 临时文件（非源码）
# ============================================================
_debug/
_debug_archive/
_*.txt
_*.py
*.bak
build_output.txt
build_quick.bat
build_refresh.txt

# ============================================================
# 美术素材（原模组许可限制，不随附源码重新分发）
# 只要与美术相关一律不纳入，仅保留纯文本代码 / 配置
# ============================================================
# 贴图（含 mod 图标）
**/*.png
# 音频
**/*.ogg
# 3D 模型（二进制）与材质
**/*.obj
**/*.mtl
**/*.bbmodel
**/*.fbx
**/*.gltf
**/*.glb
# 字体（美术资源）
**/*.ttf
**/*.otf
**/*.woff
**/*.woff2
# 模型定义 JSON（block / item 模型）
src/main/resources/assets/*/models/**/*.json
# 纹理 / 音频 动画元数据（随美术资源）
src/main/resources/assets/**/*.mcmeta
# 其他图片格式
**/*.jpg
**/*.jpeg
**/*.gif
**/*.bmp
**/*.tga
**/*.webp
**/*.psd
**/*.ai
**/*.svg
# 其他音频格式
**/*.mp3
**/*.wav
**/*.flac
**/*.aac
**/*.m4a
# 视频
**/*.mp4
**/*.webm
**/*.avi
**/*.mov
# 其他 3D 格式
**/*.3ds
**/*.max
**/*.blend
**/*.dae
**/*.x3d
**/*.c4d
# 裸二进制（非源码，含编译产物）
**/*.bin
**/*.class

# ============================================================
# 保留项说明（用户明确：第三方依赖与库全部保留）
#   libs/    第三方依赖 jar（Create / Flywheel / Ponder / Registrate 等）
#   natives/ 原生库（Rapier 安卓 .so 等）
#   以上均不在排除范围，正常纳入版本控制
# ============================================================
